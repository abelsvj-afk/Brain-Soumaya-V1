# --- LLM providers (Phase II+). Everything up to the galaxy renders without these. ---
GEMINI_API_KEY=
OPENAI_API_KEY=

# Active structured-extraction model
LLM_MODEL=gemini-2.5-flash

# --- Embeddings (server-side, local by default) ---
# Default 384-dim MiniLM for fast cold-start. Upgrade to Xenova/gte-base (768) is a re-embed.
EMBED_MODEL=Xenova/all-MiniLM-L6-v2
EMBED_DIM=384

# --- Storage ---
DB_PATH=./brain.db

# --- Web push (optional; the feature is INVISIBLE until all three are set) ---
# Generate a keypair with: npm exec -w @brain/server -- web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: or https: contact URI for the push services.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- Whole-brain backups, G0 (optional; off-volume stage is inert until all are set) ---
# BACKUP_ENCRYPTION_KEY: 32-byte key, base64-encoded, for encrypting the
# off-volume backup copy (AES-256-GCM). Set as a Fly secret; keep one
# offline copy — a backup whose key is lost is a failed backup by design.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACKUP_ENCRYPTION_KEY=
# Cloudflare R2 (S3-compatible) destination for the encrypted copies:
# BACKUP_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BACKUP_R2_BUCKET=
# BACKUP_R2_ACCESS_KEY_ID=
# BACKUP_R2_SECRET_ACCESS_KEY=
# BACKUP_R2_REGION=auto

# --- Owner access (optional) ---
# Comma-separated SPACE IDS (not gamer tags) exempt from the worlds' progression gates
# (People, Eternity). Get yours from Settings -> Owner access -> "Copy my brain key".
# It is a credential: set it as a secret (fly secrets set OWNER_SPACE_IDS=...), never commit it.
# OWNER_SPACE_IDS=
